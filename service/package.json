{
  "name": "bubbletranslate-licence",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "schema": "wrangler d1 execute bubbletranslate-licence --local --file=schema.sql",
    "schema:reset": "wrangler d1 execute bubbletranslate-licence --local --file=reset.sql && npm run schema",
    "schema:remote": "wrangler d1 execute bubbletranslate-licence --remote --file=schema.sql",
    "predeploy": "git fetch -q origin main && git merge-base --is-ancestor origin/main HEAD || (echo this checkout is behind origin/main: pull before deploying && exit 1)",
    "deploy": "wrangler deploy",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260831.1",
    "typescript": "^5.7.0",
    "vitest": "~4.1",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260831.1": true
  }
}
