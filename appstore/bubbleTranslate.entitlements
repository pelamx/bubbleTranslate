<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store build. The sandbox is required there; the one door
     opened in it is outgoing connections, for the translation itself and for
     the licence service. Accessibility, Input Monitoring and Screen Recording
     are not entitlements: the user grants them in System Settings. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
